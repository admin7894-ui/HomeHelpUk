{
  "expo": {
    "name": "HomeHelpUK",
    "slug": "homehelpuk-poc",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFF8EF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homehelpuk.poc",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "icon": "./assets/icon.png",
    "jsEngine": "hermes",
    "android": {
      "package": "com.homehelpuk.poc",
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E0F2FE"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0284C7",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5d61a1d9-6d9e-4fc2-8bef-988915d7c4c2"
      }
    }
  }
}
